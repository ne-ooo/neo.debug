{
  "name": "@lpm.dev/neo.debug",
  "version": "1.0.0",
  "description": "Zero-dependency debugging utility - Fast, modern alternative to debug",
  "author": "neo",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/node/index.node.d.ts",
      "browser": {
        "types": "./dist/browser/index.browser.d.ts",
        "import": "./dist/browser/index.js"
      },
      "node": {
        "types": "./dist/node/index.node.d.ts",
        "import": "./dist/node/index.js",
        "require": "./dist/node/index.cjs"
      },
      "default": "./dist/node/index.js"
    }
  },
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.js",
  "types": "./dist/node/index.node.d.ts",
  "files": [
    "dist",
    ".lpm/skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && tsc --project tsconfig.build.node.json && tsc --project tsconfig.build.browser.json",
    "bench": "vitest bench --run",
    "security:audit": "lpm audit --fail-on=vuln",
    "test": "vitest run",
    "test:artifacts": "tsc --noEmit --strict --target ES2022 --module ESNext --moduleResolution bundler --skipLibCheck test/artifacts/types.smoke.ts && node test/artifacts/exports.smoke.mjs",
    "test:package": "lpm publish --check && node test/artifacts/packed.smoke.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "debug",
    "debugging",
    "log",
    "logger",
    "namespace",
    "wildcard",
    "printf",
    "browser",
    "node",
    "typescript"
  ],
  "peerDependencies": {
    "@lpm.dev/neo.colors": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@lpm.dev/neo.colors": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^3.2.7",
    "debug": "^4.4.3",
    "esbuild": "0.28.1",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ne-ooo/neo.debug"
  },
  "bugs": {
    "url": "https://github.com/ne-ooo/neo.debug/issues"
  },
  "homepage": "https://github.com/ne-ooo/neo.debug#readme"
}
